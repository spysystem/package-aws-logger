{
	"name": "spysystem/package-aws-logger",
	"description": "SPY Package AWS Logger",
	"minimum-stability": "stable",
	"license": "proprietary",
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"Spy\\Package\\AwsLogger\\": "src"
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://repo.packagist.com/spysystem/"
		},
		{
			"packagist.org": false
		}
	],
	"require-dev": {
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"spysystem/code-helper": "~2.0.10"
	},
	"require": {
		"php": "~8.5.0",
		"aws/aws-sdk-php": "~3.366",
		"guzzlehttp/promises": "~2.3",
		"guzzlehttp/psr7": "~2.12",
		"psr/http-factory": "~1.1",
		"psr/http-message": "~1.1 || ~2.0",
		"ramsey/uuid": "~4.9.2",
		"spysystem/package-centralized-logger-data": "~1.1.0",
		"spysystem/package-data": "~1.1.0",
		"spysystem/package-rest": "~1.3.2"
	}
}
