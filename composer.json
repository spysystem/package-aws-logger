{
	"name": "spysystem/package-aws-logger",
	"description": "SPY Package AWS Logger",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"license": "proprietary",
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"Spy\\Package\\AwsLogger\\": "src"
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://repo.packagist.com/spysystem/"
		},
		{
			"packagist.org": false
		}
	],
	"require-dev": {
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"spysystem/code-helper": "~2.0",
		"spysystem/package-cache": "dev-je_123328_v1_2_require_cleanup as 1.2.0",
		"spysystem/package-collection": "dev-je_123328_v1_2_require_cleanup as 1.2.0",
		"spysystem/package-error-handling": "dev-je_123328_v1_2_require_cleanup as 1.2.0",
		"spysystem/package-render": "dev-je_123328_v1_3_require_cleanup as 1.3.0"
	},
	"require": {
		"php": "~8.5.0",
		"aws/aws-sdk-php": "^3.337.3",
		"guzzlehttp/promises": "~2.1",
		"guzzlehttp/psr7": "~2.11",
		"psr/http-factory": "~1.1",
		"psr/http-message": "~1.1 || ~2.0",
		"ramsey/uuid": "~4.7",
		"spysystem/package-centralized-logger-data": "dev-je_123328_v1_1_require_cleanup as 1.1.0",
		"spysystem/package-data": "dev-je_123328_v1_1_require_cleanup as 1.1.0",
		"spysystem/package-rest": "dev-je_123328_v1_3_require_cleanup as 1.3.2"
	}
}
